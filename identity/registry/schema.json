{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentIdentityRecord",
  "type": "object",
  "required": ["id", "name", "tier", "owner", "scopes", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique agent identifier"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "description": "Human-readable agent name"
    },
    "tier": {
      "type": "string",
      "enum": ["T1", "T2", "T3"],
      "description": "Agent authorization tier"
    },
    "owner": {
      "type": "object",
      "required": ["team", "email", "cost_center"],
      "additionalProperties": false,
      "properties": {
        "team": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "cost_center": {
          "type": "string"
        }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "events:ingest",
          "events:read",
          "incidents:read",
          "incidents:write",
          "posture:read",
          "posture:write",
          "hunt:launch",
          "hunt:read",
          "agents:manage",
          "sessions:revoke"
        ]
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
